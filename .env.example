# Private server environment. Never place these in public/, config.js, or a Pages build.
OPENAI_API_KEY=
TMDB_READ_TOKEN=
OPENAI_MODEL=gpt-4.1-mini
PORT=4173
# Origin only (no repository path). Include your custom Pages origin if applicable.
ALLOWED_ORIGINS=http://localhost:4173,https://YOUR-USERNAME.github.io
# Hard cap of attempted uncached OpenAI calls per UTC day, including failed calls.
MAX_DAILY_GENERATIONS=100
DATA_DIR=.data
# Keep off unless behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
